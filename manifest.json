{
  "manifest_version": 3,
  "name": "MALAQBI CPMK Assistant",
  "version": "1.0.0",
  "description": "Asisten cerdas otomasi input CPMK MALAQBI Unsulbar dari file Excel dengan AI Matcher (Gemini & OpenAI)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://malaqbi.unsulbar.ac.id/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Buka MALAQBI Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://malaqbi.unsulbar.ac.id/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
